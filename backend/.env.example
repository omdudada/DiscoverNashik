PORT=5000
NODE_ENV=development

# Relational data: places, categories, businesses, business_applications,
# admins, events. Chosen because this data is structured, has clear
# relationships (place -> category, business -> application -> admin
# decision), and benefits from Supabase Row Level Security for
# public-read / admin-write access rules.
DATABASE_URL=postgresql://user:password@localhost:5432/discover_nashik
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Document data: lost/found reports, groups, group members, group
# messages, live location pings. Chosen because this data is
# high-write, loosely structured (optional photos/fields vary per
# report), and does not need relational joins or RLS in the same way.
MONGO_URI=mongodb://localhost:27017/discover_nashik

JWT_SECRET=change-this-in-production
AI_SERVICE_API_KEY=
